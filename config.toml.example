# ==============================================================================
# ShouXin（守心）v0.4.0 多源大模型后端配置示例
# ==============================================================================
#
# 本文件展示所有支持的 LLM 来源配置方式。
# 使用时复制为 config.toml，取消注释所需配置段即可。
#
# 环境变量覆盖格式: SHOUXIN__<SECTION>__<KEY> (双下划线分隔嵌套)
#   示例: SHOUXIN__LLM__PRIMARY=api
#         SHOUXIN__LLM__OLLAMA__MODEL=llama3.2:3b
#         SHOUXIN__LLM__API__API_KEY=sk-xxx
#
# 模型来源说明:
#   ollama - 本地 Ollama 服务 (http://localhost:11434)
#   gguf   - 内置 llama.cpp GGUF 本地推理 (需 cargo build --features gguf)
#   api    - 网络 API，兼容 OpenAI Chat Completions 格式
#
# 主备切换:
#   配置 primary + secondary 后，主模型连续失败 3 次自动切换至备模型。
#   主模型恢复后需手动切回（通过管理 API: POST /admin/llm/switch）。
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM 多源配置
# ------------------------------------------------------------------------------
[llm]

# 主模型来源（必填）：ollama / gguf / api
primary = "ollama"

# 备模型来源（可选）：当主模型不可用时自动切换
# secondary = "api"

# 全局默认参数（各后端可覆盖部分）
temperature = 0.7
max_tokens = 2000
timeout_secs = 60

# ------------------------------------------------------------------------------
# 后端 1: Ollama
# ------------------------------------------------------------------------------
# 前置条件: ollama serve 已启动 + ollama pull <model>
[llm.ollama]
model = "llama3.2:3b"              # 模型名称（需已拉取）
endpoint = "http://localhost:11434" # Ollama API 地址
timeout_secs = 120                  # 请求超时
max_retries = 2                     # 失败重试次数

# ------------------------------------------------------------------------------
# 后端 2: GGUF (llama.cpp)
# ------------------------------------------------------------------------------
# 前置条件: cargo build --features gguf
# 需要将 .gguf 模型文件放置在指定路径
# [llm.gguf]
# model_path = "./models/llama-7b-q4_k_m.gguf"  # 模型文件路径
# context_size = 2048                            # 上下文窗口大小
# threads = 4                                    # CPU 推理线程数
# batch_size = 512                               # 批处理大小
# n_gpu_layers = 0                               # GPU 层数（0=纯CPU）

# ------------------------------------------------------------------------------
# 后端 3: 网络 API（OpenAI 兼容）
# ------------------------------------------------------------------------------
# 支持任意 OpenAI Chat Completions 兼容接口
# 环境变量引用: ${VAR_NAME} 格式，从运行时环境读取
# [llm.api]
# endpoint = "https://api.openai.com/v1/chat/completions"
# api_key = "${OPENAI_API_KEY}"               # 支持环境变量引用
# model = "gpt-3.5-turbo"
# timeout_secs = 30
# max_retries = 3
# headers = { "X-Custom-Header" = "value" }   # 可选自定义请求头

# ------------------------------------------------------------------------------
# 心跳模块独立 LLM 配置（可选）
# ------------------------------------------------------------------------------
# 如果不配置，心跳模块将使用主 LLM 配置
[llm.heartbeat]
backend = "ollama"
model = "llama3.2:3b"
endpoint = "http://localhost:11434"
temperature = 0.3
max_tokens = 500

# ------------------------------------------------------------------------------
# 嵌入模型配置
# ------------------------------------------------------------------------------
[embedder]
# FastEmbed 模型缓存目录（下载的 onnx 模型存放位置）
model_path = "./.fastembed_cache"

# ------------------------------------------------------------------------------
# 心跳模块配置
# ------------------------------------------------------------------------------
[heartbeat]
enabled = true                # 是否启用心跳（false 时不会启动后台调度）
base_interval_secs = 60       # 基础心跳间隔
min_interval_secs = 30        # 最小间隔（有新记忆时更勤快）
max_interval_secs = 120       # 最大间隔（长时间空闲时更稀疏）
adaptive = true               # 自适应间隔：按"距上次记忆写入"的时长动态调整
idle_threshold_secs = 30      # 空闲判定阈值（超过该时长视为空闲）
maintenance_timeout_secs = 30 # 维护阶段超时（纯 SQL，不调用 LLM）
llm_timeout_secs = 120        # LLM 阶段超时
memory_threshold_mb = 4096    # 可用内存低于该值时跳过心跳
max_consecutive_skips = 3     # 低内存时最多连续跳过次数（超过强制执行）

# ------------------------------------------------------------------------------
# 存储配置
# ------------------------------------------------------------------------------
[storage]
data_dir = "./data"
dictionary_dir = "dictionary"
relational_dir = "relational"
vector_dir = "vector"
relational_db_file = "relational.db"
vector_index_file = "vectors.hnsw"
question_pool_dir = "heartbeat/questions"

# ------------------------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------------------------
[logging]
level = "info"                # trace / debug / info / warn / error
dir = "./logs"
max_file_size_mb = 10

# ------------------------------------------------------------------------------
# 记忆提取流水线配置
# ------------------------------------------------------------------------------
[extraction]
# 单次 LLM 提取超时（秒）。超时后自动降级为正则提取。
timeout_secs = 600
# 启动时"多旧的 prepared 写入意图"视为崩溃残留（秒）
intent_grace_secs = 300

# ------------------------------------------------------------------------------
# Agent 配置
# ------------------------------------------------------------------------------
[agent]
primary_agent_id = "primary_agent"
internal_api_token = "<your-token-here>"  # 生产环境请修改

# ==============================================================================
# 多源切换场景示例
# ==============================================================================
#
# 场景 1: 纯 Ollama（默认）
#   primary = "ollama"
#   + [llm.ollama] 配置
#
# 场景 2: 纯 API
#   primary = "api"
#   + [llm.api] 配置
#
# 场景 3: 纯 GGUF
#   primary = "gguf"
#   + [llm.gguf] 配置
#   + cargo build --features gguf
#
# 场景 4: Ollama 主 + API 备（推荐生产用）
#   primary = "ollama"
#   secondary = "api"
#   + [llm.ollama] 配置
#   + [llm.api] 配置
#
# 场景 5: API 主 + Ollama 备
#   primary = "api"
#   secondary = "ollama"
#   + [llm.api] 配置
#   + [llm.ollama] 配置
# ==============================================================================
# ------------------------------------------------------------------------------
# 待办生命周期策略
# ------------------------------------------------------------------------------
[todo]
max_pending_before_archive = 50  # 待办数量超过该值时归档最旧的
archive_keep_count = 50          # 归档时保留的 pending 数量
reminder_threshold = 30          # 超过该数量时由心跳生成"任务提醒"
archive_after_days = 30          # 超过该天数未更新视为陈旧
